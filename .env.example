# ==========================================
# The Artisan's Quill — Environment Settings
# ==========================================

# 1. Supabase Cloud Database & Storage (Free Tier)
# Get these free values from https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key # For secure serverless upload routes

# 2. Google Gemini AI Key (Optional, for lyrical & poetry assistant)
GEMINI_API_KEY=

# 3. Firebase Web App Configuration (Edge Replication)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
